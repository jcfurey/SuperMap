<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>semantic_mapping</name>
  <version>0.1.0</version>
  <description>
    SuperMap: a training-free spatio-temporal SLAM system that fuses high-frequency
    geometric SLAM with asynchronous open-vocabulary perception into a queryable
    4D scene graph for language-guided navigation. Originally developed by
    SuperX SLAM / AirLab, Carnegie Mellon University (https://superodometry.com/supermap);
    this fork adds lifecycle nodes, typed interfaces and dense-cloud labelling.
  </description>
  <maintainer email="jcameronfurey@gmail.com">jcfurey</maintainer>
  <license>MIT</license>

  <url type="website">https://superodometry.com/supermap</url>
  <url type="repository">https://github.com/jcfurey/SuperMap</url>
  <url type="bugtracker">https://github.com/jcfurey/SuperMap/issues</url>

  <author>SuperX SLAM / AirLab, Carnegie Mellon University</author>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>lifecycle_msgs</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>supermap_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>sensor_msgs_py</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>vision_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>diagnostic_updater</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>message_filters</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <!-- Only imported when nav2_send_goal is enabled; the node runs without it. -->
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-opencv</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>action_msgs</test_depend>
  <test_depend>builtin_interfaces</test_depend>
  <test_depend>tf2_msgs</test_depend>
  <test_depend>rosbag2_py</test_depend>
  <test_depend>rosidl_runtime_py</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
